# CampusMate AI Environment Variables
PORT=8000
HOST=0.0.0.0

# MongoDB Atlas Configuration
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=campusmate_db

# ChromaDB Configuration
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION_NAME=campusmate_docs

# Security & Authentication
JWT_SECRET=campusmate_ai_secure_jwt_secret_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Settings (e.g. OpenAI / Gemini / Groq / Anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
